{
  "name": "better-stars",
  "version": "0.1.1",
  "description": "把 GitHub 星标变成一张能记住你为什么 star 的个人仓库地图。",
  "author": "sneaker <sneaker@agent.qq.com>",
  "bugs": {
    "email": "sneaker@agent.qq.com"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "screenshots": "node scripts/generate-screenshots.mjs",
    "zip": "rm -rf dist starmap-*.zip && pnpm build && cd dist && zip -r ../starmap-0.1.1-chrome.zip . -x '*.DS_Store' -x '__MACOSX*'"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@preact/preset-vite": "^2.10.1",
    "@types/chrome": "^0.0.279",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
